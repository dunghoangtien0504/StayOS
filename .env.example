# =====================================================
# StayOS Environment Variables
# Copy this file to .env.local for local development
# On VPS, create .env.production with real values
# NEVER commit .env.local or .env.production to Git!
# =====================================================

# ── App Config ────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://stay.dunghoang.com

# ── Pancake Multi-Channel API ─────────────────────
# Get from: pancake.vn → Cài đặt → Công cụ → Public API access token
# One token per page, comma-separated (page_id is encoded in the token)
PANCAKE_PAGE_TOKENS=
PANCAKE_API_BASE=https://pages.fm/api

# ── GoClaw AI Agent ───────────────────────────────
# URL của GoClaw server (local hoặc VPS)
GOCLAW_API_URL=http://localhost:18790
# API Key: lấy từ GoClaw → Settings → API Keys
GOCLAW_API_KEY=
# agent_key của agent muốn dùng (xem trong GoClaw → Agent)
GOCLAW_AGENT_KEY=ta-thong-dong

# ── Supabase Database ─────────────────────────────
# Get from: supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Auth (future) ────────────────────────────────
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=https://stay.dunghoang.com
