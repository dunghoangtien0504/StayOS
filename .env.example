# =====================================================
# StayOS Environment Variables
# Copy this file to .env.local for local development
# On VPS, create .env.production with real values
# NEVER commit .env.local or .env.production to Git!
# =====================================================

# ── App Config ────────────────────────────────────
NODE_ENV=development
PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Production: NEXT_PUBLIC_APP_URL=https://stayos.hoangtiendung.com

# ── Pancake Multi-Channel API ─────────────────────
# Get from: pancake.vn → Cài đặt → Công cụ → Public API access token
# One token per page, comma-separated (page_id is encoded in the token)
PANCAKE_PAGE_TOKENS=
PANCAKE_API_BASE=https://pages.fm/api

# ── Database (future) ─────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/stayos

# ── Auth (future) ────────────────────────────────
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=https://stayos.hoangtiendung.com
